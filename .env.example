# --- SQLite ---------------------------------------------------------------
# Chạy local: KHÔNG cần khai báo gì, dữ liệu nằm ở ./data/mochee.db (SQLite file).
# Trên Vercel: hệ thống file chỉ đọc, nên dùng SQLite trên Turso (libSQL).
# Vercel > Storage > Marketplace > Turso sẽ tự thêm 2 biến dưới đây.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Trang quản trị /admin (xem danh sách khách, xoá lời chúc) -------------
# Đặt một chuỗi bí mật bất kỳ, đủ dài. Bỏ trống thì /admin bị khoá.
ADMIN_KEY=

# --- Tuỳ chọn: domain chính thức để ảnh xem trước (Zalo/Facebook) đúng link --
NEXT_PUBLIC_SITE_URL=
